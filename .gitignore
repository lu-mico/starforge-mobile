# Godot-specific ignores
.godot/
.import/
android/.gradle/
android/build/
android/app/build/
android/local.properties
*.translation

# Imported translations (automatically generated from CSV files)
*.po

# Mono-specific ignores
.mono/
data_*/
mono_crash.*.json

# Godot-specific ignores
android/plugins/

# System/tool-specific ignores
.directory
*~

# Godot 4+ specific ignores
# NOTE: *.uid is deliberately NOT ignored. Godot 4.4+ assigns each script a
# stable UID that scenes reference. Regenerating them per-clone breaks
# scene->script links. Keep them in VCS (same fix as starlight-jump eb07fbc).
*.import.backup

# Build outputs (don't commit binaries)
build/
*.apk
*.aab
*.keystore
!debug.keystore

# OS files
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/
*.swp
*.swo

# Logs
*.log
